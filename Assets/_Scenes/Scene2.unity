      objectReference: {fileID: 1509706656}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: dialogueChoices.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: dialogueChoices.Array.data[0].choiceText
      value: "T\xF4i \u0111\u1ED3ng \xFD!"
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: dialogueChoices.Array.data[1].choiceText
      value: "T\xF4i s\u1EBD gi\xFAp b\u1EA1n."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: questChats.Array.data[0].lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: questChats.Array.data[1].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[0]'
      value: "C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 c\u1EE9u t\xF4i. B\u1EA1n t\u1EEB
        l\xE0ng Rufen \u0111\u1EBFn \u0111\xE2y \u0111\xFAng kh\xF4ng."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[1]'
      value: "V\u1EADy ch\u1EAFc b\u1EA1n \u0111\xE3 nghe c\xE2u chuy\u1EC7n t\u1EEB
        ng\u01B0\u1EDDi anh c\u1EE7a t\xF4i \u1EDF l\xE0ng m\xE0 b\u1EA1n \u0111\xE3
        \u0111i qua tr\u01B0\u1EDBc khi \u0111\u1EBFn \u0111\xE2y."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[2]'
      value: "T\xF4i mong b\u1EA1n h\xE3y gi\xFAp t\xF4i ti\xEAu di\u1EC7t t\xEAn
        tr\xF9m s\xF2 c\u1EE7a b\u1ECDn Bone Wraith."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[3]'
      value: "T\xF4i s\u1EBD t\u1EB7ng b\u1EA1n ph\u1EA7n th\u01B0\u1EDFng khi ho\xE0n
        th\xE0nh nhi\u1EC7m v\u1EE5."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[4]'
      value: "Ch\xFAc b\u1EA1n may m\u1EAFn......"
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[5]'
      value: "Ch\xFAc b\u1EA1n may m\u1EAFn."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[6]'
      value: "Nhi\u1EC7m v\u1EE5 \u0111\u1EA7u ti\xEAn: ti\xEAu di\u1EC7t 3 t\xEAn
        Cung Th\u1EE7 kh\xF4ng \u0111\u1ED9i m\u0169."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[7]'
      value: "Nhi\u1EC7m v\u1EE5 th\u1EE9 2:  ti\xEAu di\u1EC7t 5 t\xEAn Cung Th\u1EE7
        c\xF3 \u0111\u1ED9i m\u0169.\n."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[0]'
      value: "Nhi\u1EC7m v\u1EE5 th\u1EE9 2:  ti\xEAu di\u1EC7t 5 t\xEAn Cung Th\u1EE7
        c\xF3 \u0111\u1ED9i m\u0169."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[1]'
      value: "Ch\xE0o chi\u1EBFn binh, t\xF4i l\xE0 Tinh Linh R\u1EEBng Sylia. C\xF3
        l\u1EBD b\u1EA1n t\u1EEB l\xE0ng Rufen \u0111\u1EBFn \u0111\xE2y, nh\u1EEFng
        g\xEC c\u1EADu s\u1EAFp \u0111\u1ED1i m\u1EB7t \u1EDF \u0111\xE2y s\u1EBD
        kh\xE1c bi\u1EC7t ho\xE0n to\xE0n."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[2]'
      value: "B\u1ECDn Bone Wraith \u1EDF \u0111\xE2y r\u1EA5t m\u1EA1nh m\u1EBD.
        N\u01A1i \u0111\xE2y \u0111\xE3 b\u1ECB ch\xFAng chi\u1EBFm ho\xE0n to\xE0n
        v\xE0 c\xE1nh r\u1EEBng s\u01B0\u01A1ng m\xF9 n\u01A1i \u0111\xE2y l\xE0
        n\u01A1i l\xED t\u01B0\u1EDFng \u0111\u1EC3 ch\xFAng h\xE0ng \u0111\u1ED9ng
        ch\xFAng tho\xE1t \u1EA9n tho\xE1t hi\u1EC7n t\u1EA5n c\xF4ng b\u1EA5t c\u1EE9
        l\xFAc n\xE0o."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[3]'
      value: "Ch\xFAng c\xF3 m\u1ED9t t\xEAn tr\xF9m c\u1EA7m \u0111\u1EA7u nghe
        m\u1ED9t v\xE0i ng\u01B0\u1EDDi s\u1ED1ng s\xF3t k\u1EC3 l\u1EA1i ch\u01B0a
        k\u1EBB n\xE0o g\u1EB7p h\u1EAFn m\xE0 an to\xE0n tr\u1EDF v\u1EC1. R\u1EA5t
        nhi\u1EC1u ng\u01B0\u1EDDi \u0111\xE3 \u0111\u1EBFn khi\xEAu chi\u1EBFn nh\u01B0ng
        ch\u01B0a th\u1EA5y ai tr\u1EDF l\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[4]'
      value: "N\u1EBFu b\u1EA1n \u0111\u1EE7 can \u0111\u1EA3m h\xE3y gi\xFAp t\xF4i
        ho\xE0n th\xE0nh m\u1ED9t s\u1ED1 nhi\u1EC7m v\u1EE5 \u0111\u1ED5i l\u1EA1i
        t\xF4i s\u1EBD cho b\u1EA1n nh\u1EEFng v\u1EADt ph\u1EA9m m\u1EA1nh m\u1EBD."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[5]'
      value: "Ch\xFAc b\u1EA1n may m\u1EAFn."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[6]'
      value: "Nhi\u1EC7m v\u1EE5 \u0111\u1EA7u ti\xEAn: ti\xEAu di\u1EC7t 3 t\xEAn
        Cung Th\u1EE7 kh\xF4ng \u0111\u1ED9i m\u0169."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: dialogueChoices.Array.data[0].followUpLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: dialogueChoices.Array.data[1].followUpLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[0]'
      value: "T\xF4i s\u1EBD ti\xEAu di\u1EC7t ch\xFAng."
      objectReference: {fileID: 0}
    - target: {fileID: 9143588713338968593, guid: 3dbf211848fa9f3439e5a977c14727c1, type: 3}
      propertyPath: 'dialogueChoices.Array.data[1].followUpLines.Array.data[0]'
      value: "T\xF4i s\u1EBD cho ch\xFAng n\u1EBFm m\xF9i!"
      objectReference: {fileID: 0}
