    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[0]'
      value: "Ch\xE0o m\u1EEBng c\u1EADu \u0111\xE3 \u0111\u1EBFn ng\xF4i l\xE0ng
        c\u1EE7a ch\xFAng t\xF4i, l\u0169 Bone Wraith \u0111\xE3 x\xE2m chi\u1EBFm
        ng\xF4i l\xE0ng c\u0169 c\u1EE7a t\xF4i r\u1ED3i"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[1]'
      value: "T\xF4i \u0111\xE3 c\xF9ng c\xE1c chi\u1EBFn binh anh d\u0169ng chi\u1EBFn
        \u0111\u1EA5u nh\u01B0ng b\u1ECDn ch\xFAng qu\xE1 m\u1EA1nh , nhi\u1EC1u
        ng\u01B0\u1EDDi \u0111\xE3 anh d\u0169ng hi sinh "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[2]'
      value: "T\xF4i c\u0169ng kh\xF4ng th\u1EC3 chi\u1EBFn \u0111\u1EA5u n\u1EEFa,th\u1EADt
        m\u1EEBng c\u1EADu \u0111\xE3 \u0111\u1EBFn .B\xE2y gi\u1EDD c\u1EA3 n\u01A1i
        \u0111\xE2y \u0111\u1EC1u \u0111\xE3 b\u1ECB chi\u1EBFm"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[3]'
      value: "C\u1EADu l\xE0 m\u1ED9t trong nh\u1EEFng anh h\xF9ng \u0111\u01B0\u1EE3c
        c\u1EED t\u1EDBi \u0111\xE2y,c\u1EADu l\xE0 hi v\u1ECDng cu\u1ED1i c\xF9ng
        c\u1EE7a ch\xFAng t\xF4i,h\xE3y gi\xFAp ch\xFAng t\xF4i "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[4]'
      value: "C\u1EADu l\xE0m nh\u1EEFng nhi\u1EC7m v\u1EE5 t\xF4i \u0111\u01B0a
        ra t\xF4i s\u1EBD \u0111\u01B0a l\u1EA1i c\u1EADu c\xE1c v\u1EADt ph\u1EA9m
        t\u1ED1t \u0111\u1EC3 t\u0103ng s\u1EE9c m\u1EA1nh"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[5]'
      value: "\u0110\xE2y l\xE0 nhi\u1EC7m v\u1EE5 \u0111\u1EA7u ti\xEAn h\xE3y thu
        th\u1EADp r\u01B0\u01A1ng, ch\xFAng \u0111\u01B0\u1EE3c b\u1ECDn BoneWraith
        canh g\xE1c s\u1ED1 l\u01B0\u1EE3ng r\u1EA5t nhi\u1EC1u"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[6]'
      value: "C\u1EADu c\u1EA7n l\u1EA5y gi\xFAp t\xF4i 4 b\xECnh thu\u1ED1c trong
        c\xE1c r\u01B0\u01A1ng, n\u1EBFu may m\u1EAFn c\u1EADu s\u1EBD thu th\u1EADp
        \u0111\u01B0\u1EE3c Echoes"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[7]'
      value: "\u0110\xE2y l\xE0 m\u1ED9t nguy\xEAn li\u1EC7u d\xF9ng \u0111\u1EC3
        t\u0103ng s\u1EE9c m\u1EA1nh v\xE0 v\u0169 kh\xED h\xE3y mang v\u1EC1 \u0111\xE2y
        n\u1EBFu c\u1EADu thu th\u1EADp \u0111\u01B0\u1EE3c"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[8]'
      value: "Ch\xFAc c\u1EADu may m\u1EAFn chi\u1EBFn binh...."
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[9]'
      value: "S\u1EBD c\xF3 m\u1ED9t s\u1ED1 r\u01B0\u01A1ng c\xF3 Echoes l\xE0 m\u1ED9t
        v\u1EADt ph\u1EA9m qu\xFD gi\xE1 n\xE2ng c\u1EA5p v\u0169 kh\xED,n\u1EBFu
        \u0111\u01B0\u1EE3c h\xE3y mang m\u1ED9t \xEDt v\u1EC1 \u0111\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[0]'
      value: "T\xF4i c\xF3 m\u1ED9t ch\xFA m\xE8o \u1EDF tr\xEAn v\xF2ng c\u1ED5
        c\u1EE7a n\xF3 c\xF3 m\u1ED9t th\u1EE9 r\u1EA5t quan tr\u1ECDng \u0111\u1ED1i
        v\u1EDBi ch\xFAng t\xF4i m\u1ED9t vi\xEAn \u0111\xE1 ph\xE9p c\xF3 s\u1EE9c
        m\u1EA1nh ph\xE9p thu\u1EADt cao"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[1]'
      value: "B\u1ECDn Bone Wraith bi\u1EBFt \u0111i\u1EC1u \u0111\xF3 n\xEAn \u0111\xE3
        sai b\u1ECDn tay sai b\u1EAFt n\xF3 \u0111i nh\u1EB1m d\xF9ng m\u1EE5c \u0111\xEDch
        x\u1EA5u xa"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[2]'
      value: "H\xE3y gi\xFAp t\xF4i c\u1EE9u ch\xFA m\xE8o \u1EA5y v\xE0 mang v\u1EADt
        ph\u1EA9m  \u0111\xF3 v\u1EC1 \u0111\xE2y n\xF3  r\u1EA5t quan tr\u1ECDng "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[3]'
      value: "B\u1ECDn ch\xFAng g\u1ED3m 3 t\xEAn cung th\u1EE7 b\u1EAFn r\u1EA5t
        chu\u1EA9n h\xE3y n\xE9 m\u0169i t\xEAn v\xE0 ph\u1EA3n \u0111\xF2n ch\xFAng"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[0]'
      value: "C\u1EADu l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn \u0111\xE1nh b\u1EA1i
        \u0111\u01B0\u1EE3c b\u1ECDn ch\xFAng,th\u1EADt hi\u1EBFm c\xF3 c\u1EADu
        c\xF3 th\u1EC3 l\xE0 ng\u01B0\u1EDDi  trong l\u1EDDi ti\xEAn tri, ng\u01B0\u1EDDi
        c\xF3 th\u1EC3 \u0111\xE1nh b\u1EA1i t\xEAn ch\xFAa qu\u1EF7"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[1]'
      value: "C\xF3 m\u1ED9t ng\xF4i l\xE0ng g\u1EA7n ch\xFAng t\xF4i t\xEAn l\xE0
        l\xE0ng S\u01B0\u01A1ng M\xF9 b\u1ECB ch\xFAng chi\u1EBFm ho\xE0n to\xE0n
        n\u01A1i \u0111\u1EA5y b\xE2y gi\u1EDD ch\u1EC9 to\xE0n l\xE0 s\u01B0\u01A1ng
        m\xF9 d\xE0y \u0111\u1EB7c b\u1ECB y\u1EC3m ph\xE9p thu\u1EADt \u0111en "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[2]'
      value: "B\u1ECDn ch\xFAng c\xF3 s\u1EE9c m\u1EA1nh ho\xE0n to\xE0n kh\xE1c
        n\u01A1i \u0111\xF3 c\xF2n nguy hi\u1EC3m g\u1EA5p b\u1ED9i l\u1EA7n"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[3]'
      value: "Nh\u01B0ng \u0111\u1EC3 \u0111\u1EBFn h\xF2n \u0111\u1EA3o \u1EA5y
        th\xEC c\u1EA7n ph\u1EA3i c\xF3 b\xF9a kh\xE1ng ph\xE9p, m\u1EDBi c\xF3 th\u1EC3
        \u0111\u1EBFn \u0111\u01B0\u1EE3c n\u01A1i \u0111\xF3 m\xE0 an to\xE0n"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[4]'
      value: "Nh\u01B0ng c\u1EA7n \u0111\u1EE7 3 m\u1EA3nh v\u1EADt, t\xF4i s\u1EBD
        nh\u1EDD th\u1EE3 r\xE8n l\xE0m chi\u1EBFc v\xF2ng tay kh\xE1ng ph\xE9p khi
        \u0111\xF3 m\u1EDBi c\xF3 th\u1EC3 \u0111i \u0111\u01B0\u1EE3c "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[5]'
      value: "B\xE2y gi\u1EDD chi\u1EBFc v\xF2ng tay \u0111ang b\u1ECB t\xEAn BoneWraith
        ch\xF9y gai gi\u1EEF h\u1EAFn nh\u1EDD c\xF3 chi\u1EBFc v\xF2ng b\xE2y gi\u1EDD
        \u0111\xE3 m\u1EA1nh h\u01A1n bao gi\u1EDD h\u1EBFt"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[6]'
      value: "\u0110\xE1nh b\u1EA1i h\u1EAFn ta nh\u01B0ng h\xE3y c\u1EA9n th\u1EADn
        ch\xF9y gai c\u1EE7a h\u1EAFn b\xE2y gi\u1EDD c\xF3 s\u1EE9c m\u1EA1nh s\u1EA5m
        s\xE9t h\xE3y tr\xE1nh xa c\u1ED9t s\xE9t c\u1EE7a h\u1EAFn"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[2].lines.Array.data[7]'
      value: "B\xE2y gi\u1EDD h\u1EAFn \u0111ang \u1EDF c\xF9ng \u0111\u1ED3ng b\u1ECDn
        c\u1EE7a h\u1EAFn trong khu r\u1EEBng ch\xFAng r\u1EA5t \u0111\xF4ng h\xE3y
        c\u1EA9n th\u1EADn."
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[0]'
      value: "M\u1EA3nh gh\xE9p cu\u1ED1i c\xF9ng c\u0169ng l\xE0 nguy hi\u1EC3m
        nh\u1EA5t, m\u1EA3nh ng\u1ECDc tr\xEAn con m\u1EAFt c\xE2y r\xECu c\u1EE7a
        t\xEAn Askalor"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[1]'
      value: "T\xF4i \u0111\xE3 thua h\u1EAFn may m\u1EAFn \u0111\u01B0\u1EE3c c\u1EE9u
        s\u1ED1ng  ,h\u1EAFn r\u1EA5t m\u1EA1nh r\u1EA5t kh\u1ECFe h\u1EAFn mang
        qu\xE2n \u0111\u1EBFn \u0111\xE2y,ph\xE1 h\u1EE7y l\xE0ng m\u1EA1c,h\xFAt
        linh h\u1ED3n m\u1ECDi ng\u01B0\u1EDDi "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[2]'
      value: "B\xE2y gi\u1EDD h\u1EAFn m\u1EA1nh h\u01A1n bao gi\u1EDD h\u1EBFt v\u1EDBi
        c\xE2y r\xECu Huy\u1EBFt L\u1EC7 c\u1EE7a h\u1EAFn bao nhi\xEAu sinh m\u1EA1ng
        \u0111\xE3 ng\xE3 xu\u1ED1ng d\u01B0\u1EDBi tay h\u1EAFn"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[3]'
      value: "L\xE0 c\xE1nh tay tr\xE1i c\u1EE7a ch\xFAa qu\u1EF7 h\u1EAFn h\u1EE7y
        di\u1EC7t c\xE1c v\xF9ng \u0111\u1EA5t v\xE0 mang chi\u1EBFn l\u1EE3i ph\u1EA9m
        v\u1EC1"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[4]'
      value: "\u0110\xE2y l\xE0 ch\xFAt l\xF2ng th\xE0nh c\u1EE7a ch\xFAng t\xF4i
        mong s\u1ED1 thu\u1ED1c n\xE0y s\u1EBD gi\xFAp \u0111\u01B0\u1EE3c c\u1EADu
        trong tr\u1EADn chi\u1EBFn cu\u1ED1i c\xF9ng n\xE0y"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[3].lines.Array.data[5]'
      value: "Mong c\u1EADu s\u1EBD s\u1ED1ng s\xF3t tr\u1EDF v\u1EC1 b\u1EA3o tr\u1ECDng
        !!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[4].lines.Array.data[0]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[4].lines.Array.data[1]'
      value: "T\xF4i \u0111\xE3 thua h\u1EAFn ,h\u1EAFn r\u1EA5t m\u1EA1nh r\u1EA5t
        kh\u1ECFe h\u1EAFn mang qu\xE2n \u0111\u1EBFn \u0111\xE2y,ph\xE1 h\u1EE7y
        l\xE0ng m\u1EA1c,h\xFAt linh h\u1ED3n m\u1ECDi ng\u01B0\u1EDDi "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[4].lines.Array.data[2]'
      value: "B\xE2y gi\u1EDD h\u1EAFn m\u1EA1nh h\u01A1n bao gi\u1EDD h\u1EBFt v\u1EDBi
        c\xE2y r\xECu Huy\u1EBFt L\u1EC7 c\u1EE7a h\u1EAFn bao nhi\xEAu sinh m\u1EA1ng
        \u0111\xE3 ng\xE3 xu\u1ED1ng d\u01B0\u1EDBi tay h\u1EAFn"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[4].lines.Array.data[3]'
      value: "N\u1EBFu c\u1EADu s\u1ED1ng s\xF3t tr\u1EDF v\u1EC1 h\xE3y mang  m\u1EA3nh
        Ng\u1ECDc tr\xEAn chi\u1EBFc r\xECu c\u1EE7a h\u1EAFn v\u1EC1 \u0111\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[5].lines.Array.data[0]'
      value: "Nhi\u1EC7m v\u1EE5 cu\u1ED1i c\xF9ng:Ti\xEAu Di\u1EC7t T\xEAn \u0110\u1ED3
        T\u1EC3 Anbatukam c\xE1nh tay tr\xE1i ma v\u01B0\u01A1ng "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[5].lines.Array.data[1]'
      value: "T\xF4i \u0111\xE3 thua h\u1EAFn ,h\u1EAFn r\u1EA5t m\u1EA1nh r\u1EA5t
        kh\u1ECFe h\u1EAFn mang qu\xE2n \u0111\u1EBFn \u0111\xE2y,ph\xE1 h\u1EE7y
        l\xE0ng m\u1EA1c,h\xFAt linh h\u1ED3n m\u1ECDi ng\u01B0\u1EDDi "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[5].lines.Array.data[2]'
      value: "B\xE2y gi\u1EDD h\u1EAFn m\u1EA1nh h\u01A1n bao gi\u1EDD h\u1EBFt v\u1EDBi
        c\xE2y r\xECu Huy\u1EBFt L\u1EC7 c\u1EE7a h\u1EAFn bao nhi\xEAu sinh m\u1EA1ng
        \u0111\xE3 ng\xE3 xu\u1ED1ng d\u01B0\u1EDBi tay h\u1EAFn"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'questChats.Array.data[5].lines.Array.data[3]'
      value: "N\u1EBFu c\u1EADu s\u1ED1ng s\xF3t tr\u1EDF v\u1EC1 h\xE3y mang  m\u1EA3nh
        Ng\u1ECDc tr\xEAn chi\u1EBFc r\xECu c\u1EE7a h\u1EAFn v\u1EC1 \u0111\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: dialogueChoices.Array.data[0].followUpLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: dialogueChoices.Array.data[1].followUpLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: dialogueChoices.Array.data[2].followUpLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[0]'
      value: "H\xE3y tin t\xF4i ch\xE0ng trai, m\u1ED9t chi\u1EBFn binh kh\xF4ng
        bao gi\u1EDD n\xF3i d\u1ED1i"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[1]'
      value: "T\xF4i \u0111\xE3 qu\xE1 m\u1EC7t m\u1ECFi r\u1ED3i v\xF9ng \u0111\u1EA5t
        n\xE0y li\u1EC7u c\xF3 \u0111\u01B0\u1EE3c tr\u1EA3 l\u1EA1i h\xF2a b\xECnh
        kh\xF4ng,nh\u1EEFng anh h\xF9ng \u0111\xE3 ng\xE3 xu\u1ED1ng"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[2]'
      value: "Bao gi\u1EDD cu\u1ED9c chi\u1EBFn s\u1EBD k\u1EBFt th\xFAc, ch\xFAng
        t\xF4i \u0111\u1EB7t ni\u1EC1m tin v\xE0 hi v\u1ECDng v\xE0o c\u1EADu ch\xE0ng
        trai"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[1].followUpLines.Array.data[0]'
      value: "H\xE3y theo ch\u1EC9 d\u1EABn c\u1EE7a t\xF4i, M\u1ECDi ng\u01B0\u1EDDi
        c\u1EA7n c\u1EADu "
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[1].followUpLines.Array.data[1]'
      value: "C\u1EADu ch\xEDnh l\xE0 chi\u1EBFn binh \u0111\u01B0\u1EE3c ch\u1ECDn,
        \u0111\u1EBFn \u0111\xE2y \u0111\u1EC3 gi\xFAp ch\xFAng t\xF4i"
      objectReference: {fileID: 0}
    - target: {fileID: 8835601500180365127, guid: 3f457b0604d84b140a2f3df12ea405bc, type: 3}
      propertyPath: 'dialogueChoices.Array.data[2].followUpLines.Array.data[0]'
