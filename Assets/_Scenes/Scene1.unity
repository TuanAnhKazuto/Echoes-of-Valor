      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questList.Array.data[0]'
      value: 
      objectReference: {fileID: 1707359569}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questList.Array.data[1]'
      value: 
      objectReference: {fileID: 578498783}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: dialogueChoices.Array.data[0].choiceText
      value: "\u0110\xE3 x\u1EA3y ra chuy\u1EC7n g\xEC"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: dialogueChoices.Array.data[1].choiceText
      value: "\u0110\u01B0\u1EE3c r\u1ED3i ch\u1EDD t\xF4i ch\xFAt"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[0]'
      value: "T\xF4i.....T\xF4i \u0111\xE3 chi\u1EBFn \u0111\u1EA5u h\u1EBFt s\u1EE9c
        m\xECnh r\u1ED3i....."
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[1]'
      value: "C\u1EADu .. h\xE3y gi\xFAp t\xF4i l\xE0m n\u1ED1t m\u1ED9t v\xE0i nhi\u1EC7m
        v\u1EE5 t\xF4i kh\xF4ng c\xF2n nhi\u1EC1u th\u1EDDi gian n\u1EEFa "
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[0].lines.Array.data[2]'
      value: "C\u1EADu h\xE3y ti\xEAu di\u1EC7t m\u1ED9t t\xEAn Bone Wraith  \u0111ang
        g\xE1c c\u1EA3nh c\u1ED5ng \u0111\u1EB1ng kia gi\xFAp t\xF4i...."
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[0]'
      value: "Gi\u1ECFi l\u1EAFm ch\xE0ng trai, b\xE2y gi\u1EDD h\xE3y \u0111i v\xE0o
        l\xE0ng g\u1EB7p th\u1EE7 l\u0129nh c\u1EE7a ch\xFAng t\xF4i"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[1]'
      value: "C\u1EF1u chi\u1EBFn binh Garok, \xF4ng \u1EA5y l\xE0 m\u1ED9t huy\u1EC1n
        tho\u1EA1i"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'questChats.Array.data[1].lines.Array.data[2]'
      value: "H\xE3y \u0111i mau tr\u01B0\u1EDBc khi ch\xFAng \u0111\u1EBFn. T\u1EA1m
        bi\u1EC7t chi\u1EBFn binh tr\u1EBB\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: dialogueChoices.Array.data[0].followUpLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[0]'
      value: "T\xF4i b\u1ECB b\u1ECDn ch\xFAng ph\u1EE5c k\xEDch khi \u0111ang tr\xEAn
        \u0111\u01B0\u1EDDng l\xE0m nhi\u1EC7m v\u1EE5"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[1]'
      value: "Gi\u1EDD t\xF4i kh\xF4ng th\u1EC3 di chuy\u1EC3n n\u1EEFa, nh\u1EDD
        c\u1EADu m\u1ED9t chuy\u1EC7n n\xE0y, xin h\xE3y gi\xFAp t\xF4i"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[2]'
      value: "T\xEAn BoneWraith \u0111\xF3 l\xE0 k\u1EBB s\u1ED1ng s\xF3t cu\u1ED1i
        c\xF9ng \u0111\u1EEDng \u0111\u1EC3 n\xF3 s\u1ED1ng s\xF3t"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[3]'
      value: "C\u1EADu h\xE3y c\u1EA9n th\u1EADn nh\xE9!!!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0].followUpLines.Array.data[4]'
      value: "C\u1EADu h\xE3y c\u1EA9n th\u1EADn nh\xE9!!!1"
      objectReference: {fileID: 0}
    - target: {fileID: 6847407132193323700, guid: 7f8a0d0558e82a34ebfc272fb304533f, type: 3}
      propertyPath: 'dialogueChoices.Array.data[1].followUpLines.Array.data[0]'
      value: "C\u1EA3m \u01A1n c\u1EADu h\xE3y c\u1EA9n th\u1EADn nh\xE9!!"
      objectReference: {fileID: 0}
